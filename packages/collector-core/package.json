{
  "name": "@causality/collector-core",
  "version": "0.1.0",
  "description": "Collector core for buffering, reconstructing, and flushing causal traces",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
